# Everything here is regenerated by the suite on every run, so only the sources and the
# golden baselines are tracked. Verified by mtime: these are the files a `pytest tests/`
# rewrites, and the suite passes from a checkout that has none of them.

# Export scripts written by the check_* scripts and capture_export.py
exp_*.py
# CSVs those scripts write next to themselves before running them
data_*.csv
# Figure a generated script saves when it runs
feature_comparison.svg

# Everything the parity harnesses generate: 5.6 GB of exported scripts, their input CSVs
# and their SVG outputs, one directory per check. Regenerated by parity/run_all.py and
# safe to delete -- the harness sources and README next to it are the tracked part.
parity/_work/

# One-off diagnostic drivers: standalone scripts written to answer a single question
# (e.g. why an MLE warm start moved), not collected by pytest and not imported by it.
_diag_*.py
