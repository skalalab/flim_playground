# Everything here is regenerated by the suite on every run, so only the sources and the
# golden baselines are tracked. Verified by mtime: these are the files a `pytest tests/`
# rewrites, and the suite passes from a checkout that has none of them.

# Export scripts written by the check_* scripts and capture_export.py
exp_*.py
# CSVs those scripts write next to themselves before running them
data_*.csv
# Figure a generated script saves when it runs
feature_comparison.svg
